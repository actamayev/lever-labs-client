{
	"compilerOptions": {
	  "target": "ES2023",
	  "lib": ["dom", "dom.iterable", "esnext"],
	  "allowJs": true,
	  "skipLibCheck": true,
	  "strict": true,
	  "strictNullChecks": true,
	  "forceConsistentCasingInFileNames": true,
	  "noEmit": true,
	  "esModuleInterop": true,
	  "module": "esnext",
	  "moduleResolution": "node",
	  "resolveJsonModule": true,
	  "isolatedModules": true,
	  "jsx": "preserve",
	  "incremental": true,
	  "plugins": [
		{
		  "name": "next"
		}
	  ],
	  "baseUrl": ".",
	  "paths": {
		"@/*": ["./src/*"]
	  }
	},
	"include": [
	  "next-env.d.ts",
	  "src/types/**/*.d.ts",
	  "**/*.ts",
	  "**/*.tsx",
	  ".next/types/**/*.ts",
	  "./tailwind.config.ts",
	  "next.config.js"
	],
	"exclude": ["node_modules"]
  }
  